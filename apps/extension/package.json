{
  "name": "@secureguard/extension",
  "version": "4.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && vite build --config vite.config.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@secureguard/shared": "*"
  },
  "devDependencies": {
    "@types/chrome": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}